// Prisma schema for the n8x marketing platform.
// Bilingual content is stored as JSON maps shaped like { "pt": "...", "en": "..." }
// and resolved per-request via src/lib/i18n helpers. See src/lib/content.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection. On Supabase use the pooled (Supavisor/pgBouncer) URL on
  // port 6543 with `?pgbouncer=true`. Locally it's the direct Postgres URL.
  url      = env("DATABASE_URL")
  // Direct connection used by `prisma migrate`/`db push` (migrations can't run
  // through the transaction pooler). On Supabase this is the 5432 direct URL;
  // locally it's the same as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Marketing content (managed via the admin CMS)
// ---------------------------------------------------------------------------

/// A service the agency offers (social media, branding, etc.).
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  icon        String // lucide-react icon name, e.g. "Megaphone"
  title       Json // LocalizedText
  description Json // LocalizedText
  content     Json     @default("{}") // LocalizedRichText (array of paragraphs per locale)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured, order])
  @@map("services")
}

/// An informational entry (knowledge base / "Informações"): listed in the navbar
/// burger menu and rendered as a standalone article with a sidebar of siblings.
model Information {
  id          String   @id @default(cuid())
  slug        String   @unique
  icon        String // lucide-react icon name, e.g. "Info"
  image       String   @default("") // thematic cover image URL (shown on the card)
  title       Json // LocalizedText
  description Json // LocalizedText
  content     Json     @default("{}") // LocalizedRichText (array of paragraphs per locale)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured, order])
  @@map("informations")
}

/// A portfolio case study.
model Project {
  id         String   @id @default(cuid())
  slug       String   @unique
  clientName String
  category   Json // LocalizedText
  year       Int
  coverImage String
  gallery    String[] @default([])
  tags       String[] @default([])
  title      Json // LocalizedText
  summary    Json // LocalizedText
  content    Json // LocalizedRichText (array of paragraphs per locale)
  featured   Boolean  @default(false)
  published  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, featured, order])
  @@map("projects")
}

/// A client logo shown in the "they trust us" strip.
model Client {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  website   String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

/// A client testimonial / quote.
model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  company    String
  avatarUrl  String?
  rating     Int      @default(5)
  role       Json // LocalizedText
  quote      Json // LocalizedText
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("testimonials")
}

/// A member of the team.
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  photoUrl  String?
  socials   Json     @default("{}") // { instagram?, linkedin?, ... }
  role      Json // LocalizedText
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

/// A headline statistic / animated counter.
model Stat {
  id        String   @id @default(cuid())
  key       String   @unique // "years", "logos", "clients", "ads"
  value     Int
  suffix    String   @default("")
  label     Json // LocalizedText
  order     Int      @default(0)
  published Boolean  @default(true)

  @@map("stats")
}

// ---------------------------------------------------------------------------
// Leads (contact + careers form submissions)
// ---------------------------------------------------------------------------

enum LeadType {
  CONTACT
  CAREER
}

enum LeadStatus {
  NEW
  CONTACTED
  ARCHIVED
}

model Lead {
  id        String     @id @default(cuid())
  type      LeadType   @default(CONTACT)
  status    LeadStatus @default(NEW)
  name      String
  email     String
  phone     String?
  company   String? // for CONTACT
  role      String? // desired role, for CAREER
  portfolio String? // link, for CAREER
  message   String
  tags      String[]   @default([]) // free-form labels applied by admins for triage
  locale    String     @default("pt")
  // --- Attribution (how the lead found the site — first-touch, captured client
  // side into sessionStorage and sent with the form). All optional. ---
  referrer    String? // external referrer host (e.g. google.com), "" = direct
  landingPage String? // first path of the visit (e.g. /informations/agencia-de-seo)
  /// Human label for `landingPage`, resolved + FROZEN at capture (e.g.
  /// "Informações / Agência de SEO"). Frozen so renaming/deleting content later
  /// doesn't rewrite historical attribution.
  landingLabel String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /// Set when this lead was pushed to the sales WhatsApp group (auto or manual).
  /// Null = not delivered yet; drives the "✓ WhatsApp" badge + resend recovery.
  whatsappNotifiedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([type, status, createdAt])
  @@map("leads")
}

/// Singleton config for pushing new site leads to a sales WhatsApp group via
/// Evolution. `instance` is an Evolution instance name; `groupId` is the group
/// JID (`…@g.us`). When `enabled` is false or unset, no auto-notification runs.
model LeadNotificationConfig {
  id        String   @id @default(cuid())
  enabled   Boolean  @default(false)
  instance  String? // Evolution instance name that sends the message
  groupId   String? // WhatsApp group JID ("…@g.us")
  groupName String? // group subject, for display in the admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lead_notification_config")
}
