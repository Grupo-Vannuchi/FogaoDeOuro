// Prisma schema for the n8x marketing platform.
// Bilingual content is stored as JSON maps shaped like { "pt": "...", "en": "..." }
// and resolved per-request via src/lib/i18n helpers. See src/lib/content.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection. On Supabase use the pooled (Supavisor/pgBouncer) URL on
  // port 6543 with `?pgbouncer=true`. Locally it's the direct Postgres URL.
  url      = env("DATABASE_URL")
  // Direct connection used by `prisma migrate`/`db push` (migrations can't run
  // through the transaction pooler). On Supabase this is the 5432 direct URL;
  // locally it's the same as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Marketing content (managed via the admin CMS)
// ---------------------------------------------------------------------------

/// A service the agency offers (social media, branding, etc.).
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  icon        String // lucide-react icon name, e.g. "Megaphone"
  title       Json // LocalizedText
  description Json // LocalizedText
  content     Json     @default("{}") // LocalizedRichText (array of paragraphs per locale)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured, order])
  @@map("services")
}

/// An informational entry (knowledge base / "Informações"): listed in the navbar
/// burger menu and rendered as a standalone article with a sidebar of siblings.
model Information {
  id          String   @id @default(cuid())
  slug        String   @unique
  icon        String // lucide-react icon name, e.g. "Info"
  image       String   @default("") // thematic cover image URL (shown on the card)
  title       Json // LocalizedText
  description Json // LocalizedText
  content     Json     @default("{}") // LocalizedRichText (array of paragraphs per locale)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured, order])
  @@map("informations")
}

/// A portfolio case study.
model Project {
  id         String   @id @default(cuid())
  slug       String   @unique
  clientName String
  category   Json // LocalizedText
  year       Int
  coverImage String
  gallery    String[] @default([])
  tags       String[] @default([])
  title      Json // LocalizedText
  summary    Json // LocalizedText
  content    Json // LocalizedRichText (array of paragraphs per locale)
  featured   Boolean  @default(false)
  published  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, featured, order])
  @@map("projects")
}

/// A client logo shown in the "they trust us" strip.
model Client {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  website   String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

/// A client testimonial / quote.
model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  company    String
  avatarUrl  String?
  rating     Int      @default(5)
  role       Json // LocalizedText
  quote      Json // LocalizedText
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("testimonials")
}

/// A member of the team.
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  photoUrl  String?
  socials   Json     @default("{}") // { instagram?, linkedin?, ... }
  role      Json // LocalizedText
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

/// A headline statistic / animated counter.
model Stat {
  id        String   @id @default(cuid())
  key       String   @unique // "years", "logos", "clients", "ads"
  value     Int
  suffix    String   @default("")
  label     Json // LocalizedText
  order     Int      @default(0)
  published Boolean  @default(true)

  @@map("stats")
}

// ---------------------------------------------------------------------------
// Leads (contact + careers form submissions)
// ---------------------------------------------------------------------------

enum LeadType {
  CONTACT
  CAREER
}

enum LeadStatus {
  NEW
  CONTACTED
  ARCHIVED
}

model Lead {
  id        String     @id @default(cuid())
  type      LeadType   @default(CONTACT)
  status    LeadStatus @default(NEW)
  name      String
  email     String
  phone     String?
  company   String? // for CONTACT
  role      String? // desired role, for CAREER
  portfolio String? // link, for CAREER
  message   String
  tags      String[]   @default([]) // free-form labels applied by admins for triage
  locale    String     @default("pt")
  // --- Attribution (how the lead found the site — first-touch, captured client
  // side into sessionStorage and sent with the form). All optional. ---
  referrer    String? // external referrer host (e.g. google.com), "" = direct
  landingPage String? // first path of the visit (e.g. /informations/agencia-de-seo)
  /// Human label for `landingPage`, resolved + FROZEN at capture (e.g.
  /// "Informações / Agência de SEO"). Frozen so renaming/deleting content later
  /// doesn't rewrite historical attribution.
  landingLabel String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /// Set when this lead was pushed to the sales WhatsApp group (auto or manual).
  /// Null = not delivered yet; drives the "✓ WhatsApp" badge + resend recovery.
  whatsappNotifiedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([type, status, createdAt])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Funnels (link-shared conversational lead-capture quizzes)
// ---------------------------------------------------------------------------
// Funnels are single-language (the `locale` is chosen at creation and all copy
// is stored as plain strings, NOT the bilingual LocalizedText JSON used by the
// marketing CMS). They are public but unlisted: never in nav/sitemap, noindex.

enum FunnelType {
  MEETING // ends with a Google Calendar scheduler
  BONUS // ends with a button to download a PDF
  MESSAGE // ends by sending a WhatsApp message
  REDIRECT // ends by sending the lead to an external URL
}

enum FunnelStatus {
  DRAFT
  PUBLISHED
}

enum FunnelOutcome {
  COMPLETED
  MEETING_BOOKED
  BONUS_DOWNLOADED
  MESSAGE_SENT
  REDIRECTED
}

enum WhatsappStatus {
  PENDING
  SENT
  FAILED
}

/// A conversational lead-capture quiz, shared via direct link. Single-language.
/// The ending (type + WhatsApp message + config) lives in `endings`: a funnel
/// can have several, and branching options route to a specific one. The first
/// ending (lowest `order`) is the default/fallback for the straight-through path.
model Funnel {
  id     String       @id @default(cuid())
  slug   String       @unique
  locale String       @default("pt") // "pt" | "en", chosen at creation
  name   String // internal admin label
  status FunnelStatus @default(DRAFT)

  /// Editable snapshot of the standard lead-capture opening (FunnelDefaultStep[]),
  /// copied from the global FunnelDefaultTemplate at creation and overridable.
  defaultBlock Json @default("[]")

  /// Evolution instance used for this funnel's WhatsApp sends. Null = use the
  /// default instance (env EVOLUTION_INSTANCE). Managed from the admin panel.
  whatsappInstance String?

  questions   FunnelQuestion[]
  endings     FunnelEnding[]
  submissions FunnelSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("funnels")
}

/// A named ending of a funnel. Branch options route to one of these by `key`;
/// each carries its own type, WhatsApp message and type-specific config.
model FunnelEnding {
  id       String     @id @default(cuid())
  funnelId String
  funnel   Funnel     @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  order    Int        @default(0)
  /// Stable identifier within the funnel, used as a branch target.
  key      String     @default("")
  name     String // admin label
  type     FunnelType

  /// Personalized WhatsApp sent when this ending is reached. Supports {NOME}/{CARGO}.
  completionMessage String

  // --- MEETING config ---
  meetingDurationMinutes Int?    @default(30)
  meetingSlotStartHour   Int?    @default(9)
  meetingSlotEndHour     Int?    @default(18)
  meetingDaysAhead       Int?    @default(14)
  meetingTimezone        String? @default("America/Sao_Paulo")

  // --- BONUS config ---
  bonusUrl         String? // Google Drive PDF link
  bonusButtonLabel String?

  // --- REDIRECT config ---
  redirectUrl          String? // external destination (e.g. course site)
  redirectButtonLabel  String?
  redirectDelaySeconds Int?    @default(3) // auto-redirect countdown; 0 = immediate

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([funnelId, order])
  @@map("funnel_endings")
}

/// How a custom question is answered: single-choice buttons, or free text.
enum FunnelQuestionKind {
  CHOICE
  TEXT
}

/// A custom question that runs after the default block — either single-choice
/// (buttons) or a free-text (descriptive) answer.
model FunnelQuestion {
  id       String   @id @default(cuid())
  funnelId String
  funnel   Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  order    Int      @default(0)
  /// Stable identifier within the funnel, used as a branch target. Survives edits
  /// (the DB `id` is regenerated on save, so branching can't rely on it).
  key      String   @default("")
  kind     FunnelQuestionKind @default(CHOICE)
  prompt   String
  options  String[] @default([]) // CHOICE only: ordered single-choice labels
  /// CHOICE only: per-option branch target, aligned with `options`: a question
  /// `key`, an ending `key`, "END" (the default ending), or "" (the next in order).
  optionNext String[] @default([])
  /// TEXT only: single continuation target after the answer (a question `key`,
  /// an ending `key`, "END", or "" for the next question in order).
  next     String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([funnelId, order])
  @@map("funnel_questions")
}

/// A completed run of a funnel by one visitor (the captured lead + answers).
model FunnelSubmission {
  id       String @id @default(cuid())
  funnelId String
  funnel   Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  // Captured by the default block
  name      String
  role      String? // {CARGO}
  phone     String? // raw as entered
  phoneE164 String? // normalized for WhatsApp
  email     String?

  /// Custom-question answers: [{ questionId, prompt, answer }]
  answers Json @default("[]")

  outcome FunnelOutcome @default(COMPLETED)
  /// Name of the ending the lead reached (for the admin inbox).
  endingName String?

  // MEETING
  meetingStartAt DateTime?
  googleEventId  String?

  // WhatsApp completion-message delivery
  whatsappStatus WhatsappStatus @default(PENDING)
  whatsappError  String?

  /// Client-generated idempotency key — guards against double submits.
  submissionToken String @unique

  locale    String   @default("pt")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([funnelId, createdAt])
  @@map("funnel_submissions")
}

/// OAuth tokens for the single company Google account (one row). Used by
/// MEETING funnels to read free/busy and create calendar events.
model GoogleAccount {
  id           String    @id @default(cuid())
  email        String? // connected account, for display
  accessToken  String?
  refreshToken String? // the durable credential
  expiryDate   DateTime?
  calendarId   String    @default("primary")
  scope        String?
  /// Set when Google rejects the token (invalid_grant) so the admin panel can
  /// prompt a reconnect. Cleared on a successful reconnect.
  invalidatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("google_account")
}

/// Singleton config for pushing new site leads to a sales WhatsApp group via
/// Evolution. `instance` is an Evolution instance name; `groupId` is the group
/// JID (`…@g.us`). When `enabled` is false or unset, no auto-notification runs.
model LeadNotificationConfig {
  id        String   @id @default(cuid())
  enabled   Boolean  @default(false)
  instance  String? // Evolution instance name that sends the message
  groupId   String? // WhatsApp group JID ("…@g.us")
  groupName String? // group subject, for display in the admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lead_notification_config")
}

/// Editable GLOBAL default lead-capture block — one row per locale. The admin
/// "edit default" screen edits this; new funnels copy `steps` into defaultBlock.
model FunnelDefaultTemplate {
  id        String   @id @default(cuid())
  locale    String   @unique // "pt" | "en"
  steps     Json     @default("[]") // FunnelDefaultStep[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("funnel_default_templates")
}
